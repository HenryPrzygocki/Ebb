# Maintainer: Henry Przygocki <15135183+HenryPrzygocki@users.noreply.github.com>
#
# Ebb: a TIDAL player for Linux, a modified version of hiresTI by yelanxin (GPL-3.0-or-later).
# The command is ebb-player: /usr/bin/ebb belongs to texlive-basic (dvipdfmx's extractbb).
pkgname=ebb-git
_pkgname=ebb
_appid=io.github.henryprzygocki.Ebb
pkgver=0.1.0.r79.gc4428d1
pkgrel=1
pkgdesc="TIDAL player for Linux, built for lossless and hi-res audio (based on hiresTI)"
arch=('x86_64')
url="https://github.com/HenryPrzygocki/Ebb"
license=('GPL-3.0-or-later')
# As upstream: ring's cc-built objects break under -flto (undefined ring_core_* symbols).
options=('!lto')
depends=(
  'acl'
  'alsa-lib'
  'curl'
  'glibc'
  'gst-plugin-pipewire'
  'gst-plugins-bad'
  'gst-plugins-good'
  'gst-plugins-ugly'
  'gst-python'
  'gstreamer'
  'gtk4'
  'hicolor-icon-theme'
  'libadwaita'
  'libgcc'
  'libglvnd'
  'libpulse'  # also provides pactl, used by the PipeWire sink watch
  'libusb'
  'mesa'
  'pipewire'
  'polkit'
  'python'
  'python-cairo'
  'python-dateutil'
  'python-gobject'
  'python-isodate'
  'python-mpegdash'
  'python-opengl'
  'python-pyaes'
  'python-requests'
  'python-setproctitle'
  'python-six'
  'python-tidalapi'
  'python-typing_extensions'
)
makedepends=(
  'cargo'
  'clang'
  'git'
)
optdepends=(
  'python-pillow: tray icon image loading'
  'python-pystray: system tray integration'
  'python-qrcode: QR-code login flow'
)
provides=('ebb')
# Ebb takes over hiresTI's config directories (moved, with symlinks left at the old names).
conflicts=('ebb' 'hiresti')
source=("${_pkgname}::git+${url}.git#branch=main")
sha256sums=('SKIP')

_crates=(rust_audio_core rust_viz_core rust_launcher)

pkgver() {
  cd "${_pkgname}"
  # Ebb's own tags only: upstream's v1.9.x tags live in the same history.
  git describe --long --tags --match 'ebb-v*' --abbrev=7 | sed 's/^ebb-v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd "${_pkgname}"
  export RUSTUP_TOOLCHAIN=stable
  local crate
  for crate in "${_crates[@]}"; do
    cargo fetch --locked --manifest-path "src_rust/${crate}/Cargo.toml" --target "$(rustc --print host-tuple)"
  done
}

build() {
  cd "${_pkgname}"
  export RUSTUP_TOOLCHAIN=stable
  local crate
  for crate in "${_crates[@]}"; do
    # package() takes each crate's output from its own target/, whatever a cargo config sets.
    cargo build --frozen --release --manifest-path "src_rust/${crate}/Cargo.toml" \
      --target-dir "src_rust/${crate}/target"
  done
}

package() {
  cd "${_pkgname}"

  local app_dir="${pkgdir}/usr/share/ebb"

  install -d "${app_dir}"
  cp -a src/. "${app_dir}/"
  cp -a icons "${app_dir}/"
  # icons/source/ is an unused 7.3 MB copy of upstream's old SVG; nothing loads it.
  rm -rf "${app_dir}/icons/source"
  # Compiled here, as the app's directory isn't writable at run time.
  python -m compileall -q -d /usr/share/ebb "${app_dir}"

  install -Dm644 version.txt "${app_dir}/version.txt"  # the hiresTI release Ebb is based on
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

  install -Dm755 src_rust/rust_audio_core/target/release/librust_audio_core.so \
    "${app_dir}/src_rust/rust_audio_core/target/release/librust_audio_core.so"
  install -Dm755 src_rust/rust_viz_core/target/release/libviz_core.so \
    "${app_dir}/src_rust/rust_viz_core/target/release/libviz_core.so"
  # The launcher crate keeps upstream's name; only the installed command is Ebb's.
  install -Dm755 src_rust/rust_launcher/target/release/hiresti "${pkgdir}/usr/bin/ebb-player"

  # Only the app icon goes into the system theme: the desktop entry and the shell look it up there.
  # Every other icon is looked up inside the app, which puts /usr/share/ebb/icons first on its
  # search path; installing them too put 84 generic names (go-next-symbolic, ...) into hicolor.
  local icon
  while IFS= read -r icon; do
    install -Dm644 "${icon}" "${pkgdir}/usr/share/${icon}"
  done < <(find icons/hicolor -path "*/apps/${_appid}.*")

  install -Dm644 "data/${_appid}.desktop" "${pkgdir}/usr/share/applications/${_appid}.desktop"
  install -Dm644 "data/${_appid}.metainfo.xml" "${pkgdir}/usr/share/metainfo/${_appid}.metainfo.xml"

  # USB Rawlink access, as upstream's deb/rpm ship it. The rule keeps hiresTI's file name: the
  # app's "Fix USB Permissions" looks for it there. Numbered before 73-seat-late.rules, where
  # systemd turns TAG+="uaccess" into ACLs.
  install -d "${pkgdir}/usr/lib/udev/rules.d"
  cat > "${pkgdir}/usr/lib/udev/rules.d/70-hiresti-usb-audio.rules" <<'RULE'
# Ebb (hiresTI) USB Rawlink - grant logged-in user access to USB audio devices
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ENV{ID_USB_INTERFACES}=="*:01????:*", TAG+="uaccess"
RULE
}
